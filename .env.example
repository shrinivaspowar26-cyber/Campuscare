# Campus Care - Environment Configuration Example
# ===========================================================================
# Copy this file to .env and configure values for your environment:
#   cp .env.example .env
#
# NEVER commit your real .env file or credentials to Git!

# Flask Application Secret Key (Required in production)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
CAMPUS_CARE_SECRET=your-random-32-byte-hex-secret-key-here

# Server Port (Default: 5001)
PORT=5001

# Email Notification Settings (SMTP)
# If left unset or empty, Campus Care automatically runs in DEV MODE
# (emails are printed to the server console and logged to instance/email_dev.log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-or-app-password
MAIL_FROM=no-reply@campuscare.example.com
APP_BASE_URL=http://127.0.0.1:5001
